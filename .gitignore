# Ignore everything
*

# Allow Public/ (the deploy target) and its contents
!Public/
!Public/**

# Allow config files needed for deployment
!netlify.toml
!.gitignore

# OS files (always ignore even inside Public/)
.DS_Store
Thumbs.db
Desktop.ini

# Large video files (consider Git LFS if these need versioning)
*.MOV
*.mp4

# Allow specific game videos needed for deploy
!Public/astroid-dodger/img/I.mp4
!Public/astroid-dodger/img/Finale Video.mp4
!Public/Islands/video/cucumbers-great-return.mp4

# Aperant data directory
.auto-claude/
